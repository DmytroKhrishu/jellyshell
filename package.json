{
  "name": "jellyshell-tests",
  "private": true,
  "type": "module",
  "description": "Repo-level test runner: focus engine (web + dash copies), headless app screens, dash server tests. See docs/testing.md.",
  "scripts": {
    "pretest": "node tests/setup.mjs",
    "test": "playwright test && npm run test:py",
    "test:focus": "playwright test --project=focus",
    "test:e2e": "playwright test --project=e2e",
    "test:py": "python3 -m unittest discover -s dash/server -p \"test_*.py\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12"
  }
}
