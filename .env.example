# JellyShell configuration. Copy to `.env` (gitignored) and fill in what you use; everything else can stay empty.
# Read by web-poc/server.py, dash/server/server.py, tools/*.py and docker compose. Already-set environment variables win.
# Full reference: docs/configuration.md

# ============================================================ page server (web-poc/server.py)
# LAN listener: what TVs / consoles / browsers on your network load.
JELLYSHELL_BIND=0.0.0.0
JELLYSHELL_PORT=8097
# docker compose only: host ports to publish (default 8097 / 8098 for the dash). Change these, not *_PORT, to move a
# service to another host port. The public listener is published by a compose.override.yaml, see docs/docker.md.
JELLYSHELL_HOST_PORT=
DASH_HOST_PORT=
# Optional hardened public listener for a reverse proxy / Tailscale Funnel / Cloudflare Tunnel (0 = off).
# It serves the UI under JELLYSHELL_PUBLIC_PREFIX. Bind: empty = 127.0.0.1 (bare metal) / 0.0.0.0 inside Docker
# (the container's published port is what limits access there).
JELLYSHELL_PUBLIC_PORT=0
JELLYSHELL_PUBLIC_BIND=
JELLYSHELL_PUBLIC_PREFIX=/jellyshell
# LAN debug hooks (remote-control queue /api/cmd, /snap screenshots for tools/). Never on the public listener.
JELLYSHELL_DEBUG=0
# Runtime files (client.log, subs_created.json, snaps/, apk/). Defaults: web-poc/ (Docker: /data).
JELLYSHELL_DATA_DIR=
JELLYSHELL_LOG_FILE=
# Household clock zone for "ends at" times (IANA name). Empty = TZ / the host's zone / UTC.
JELLYSHELL_TZ=
TZ=

# ------------------------------------------------------------ Jellyfin
# How the page server reaches Jellyfin. Empty = http://127.0.0.1:8096 (Docker image: http://host.docker.internal:8096,
# i.e. Jellyfin published on the Docker host). Same compose network: http://jellyfin:8096.
JELLYFIN_URL=
# Optional: the Jellyfin address CLIENTS should log in to (e.g. http://<server-lan-ip>:8096 or https://jellyfin.example.com).
# Returned to the UI as `jellyfinUrl` in GET /api/config and used as the default server on the login screen.
JELLYFIN_PUBLIC_URL=
# Optional admin API key (Jellyfin Dashboard -> API Keys). Enables subtitle tools, HDR picture controls and key scrubbing
# in client logs. JELLYFIN_API_KEY_FILE may point at a file (Docker secret) holding the raw key or JSON {"key": "..."}.
JELLYFIN_API_KEY=
JELLYFIN_API_KEY_FILE=

# ------------------------------------------------------------ optional integrations (each OFF while URL/key are empty)
# Seerr / Jellyseerr / Overseerr: Requests tab + "Request" buttons.
SEERR_URL=
SEERR_API_KEY=
# Sonarr / Radarr (either is enough): Downloads tab + release calendar (Jellyfin admins only).
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
# qBittorrent: live download speed / ETA in Downloads (needs Sonarr or Radarr too).
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Bazarr (+ JELLYFIN_API_KEY): find / download / sync subtitles from the player and detail pages.
BAZARR_URL=
BAZARR_API_KEY=
# Convenience: a directory holding the apps' config dirs (<dir>/seerr/config/settings.json, <dir>/sonarr/config/config.xml,
# <dir>/radarr/config/config.xml, <dir>/bazarr/config/config/config.yaml; qBittorrent creds from Sonarr's database).
# Missing keys are read from there; URLs then default to http://ARR_HOST:<app's default port>. Explicit values above win.
ARR_CONFIG_DIR=
ARR_HOST=
# Subtitle backups / cut checks: map the paths Bazarr reports to paths this server can open, '<their-prefix>=<local-path>'
# (';'-separated for several). Default /media=/media.
MEDIA_PATH_MAP=/media=/media

# ------------------------------------------------------------ optional pages
# Microsoft Store product id: enables /install (a link page for the Xbox browser). Empty = no /install page.
STORE_PRODUCT_ID=
STORE_PRIVATE=0

# ============================================================ dashboard (dash/server/server.py, `--profile dash`)
DASH_BIND=0.0.0.0
DASH_PORT=8098
# Weather (Open-Meteo, no key). Empty lat/lon = weather tile/page shows "not configured".
DASH_LAT=
DASH_LON=
DASH_PLACE=
# Photos (Immich API key with asset read + search). Empty = photos off.
IMMICH_URL=
IMMICH_API_KEY=
# Bearer token the Mac agent (dash/mac-agent) uses to push calendar + Home snapshots. Empty = push endpoints answer 503.
DASH_PUSH_TOKEN=
# Server tab: disks to show ("Label=/path;Label2=/path2") and the network interface (empty = auto-detect).
DASH_DISKS=System=/
DASH_NET_IF=
# Dash clock zone (empty = JELLYSHELL_TZ / TZ / host zone; in Docker falls back to the weather location's zone).
DASH_TZ=
# Featured landscape backdrops cached from Wikimedia Commons (0 = off).
DASH_BACKDROPS=150
# Legacy JSON config ({lat, lon, place, immich_url, immich_key, push_token}); env vars win. Empty = not used.
DASH_CONFIG_FILE=
DASH_DEBUG=0

# ------------------------------------------------------------ HomePod / Apple TV now playing (optional sidecar)
# Device identifier from `atvremote scan` (pyatv). Empty = sidecar exits, dash shows "Now playing isn't set up".
NP_DEVICE_ID=
NP_DEVICE_NAME=
NP_HOST=
# Where the dash finds the sidecar (default http://127.0.0.1:8102; Docker: http://nowplaying:8102).
NP_URL=
NP_BIND=
NP_PORT=8102

# ============================================================ dev tools (tools/*.py), optional
# XBOX_HOST=<xbox-lan-ip>
# XBOX_PORTAL_CRED_FILE=~/.config/xbox-devportal.cred
# JELLYSHELL_URL=http://<server-lan-ip>:8097
# JELLYFIN_CLIENT_URL=http://<server-lan-ip>:8096
# JELLYFIN_USER_ID=
# GITHUB_REPOSITORY=owner/jellyshell
# CERT_ACCOUNT_NAME=cert-tester
